 "effort_levels": {
  "standard": {
   "max_tier": "deep",
   "tier_shift": 0,
   "patterns": [
    "single"
   ]
  },
  "high": {
   "max_tier": "deep",
   "tier_shift": 0,
   "patterns": [
    "single",
    "cascade",
    "critique"
   ]
  },
  "max": {
   "max_tier": "deep",
   "tier_shift": 1,
   "patterns": [
    "single",
    "cascade",
    "critique"
   ],
   "top_tier_pattern": "critique"
  }
 },
 "default_effort": "high",
 "intent_rules": [
  {
   "re": "^\\s*(where (is|are|do|does)|find|locate|search|grep|list|show me|what (is|does|are)|how (does|do|is)|explain|summari[sz]e|why is there)\\b",
   "category": "search"
  },
  {
   "re": "^\\s*(rename|fix (a |the )?typo|reformat|format|lint|bump)\\b",
   "category": "routine_edit"
  },
  {
   "re": "^\\s*(document|update the (readme|docs|changelog)|write (the )?(docs|readme|docstrings?))\\b",
   "category": "docs"
  },
  {
   "re": "^\\s*(review|audit)\\b.*\\b(security|auth|jwt|oauth|crypt|secret|injection)",
   "category": "security"
  }
 ],
 "categories": {
  "architecture": {
   "tier": "deep",
   "min_tier": "standard",
   "pattern": "critique",
   "description": "Planning, system design, tradeoffs, migrations, large refactors.",
   "keywords": [
    "architect",
    "design (a|the|an)? ?(system|service|api|schema)",
    "trade-?offs?",
    "migrat",
    "plan (the|a|out)",
    "rfc",
    "roadmap",
    "scalab",
    "from scratch",
    "re-?architect",
    "monorepo",
    "data model"
   ]
  },
  "hard_debugging": {
   "tier": "deep",
   "min_tier": "standard",
   "pattern": "cascade",
   "description": "Root-causing non-obvious bugs, races, perf regressions, flaky tests, prod incidents.",
   "keywords": [
    "race condition",
    "deadlock",
    "memory leak",
    "flaky",
    "intermittent",
    "heisenbug",
    "root cause",
    "segfault",
    "corrupt",
    "regression",
    "only (in|on) prod",
    "perf(ormance)? (issue|regression|problem)",
    "why (does|is) .* (fail|crash|hang|slow)",
    "concurren",
    "non-?deterministic"
   ]
  },
  "security": {
   "tier": "deep",
   "min_tier": "deep",
   "pattern": "critique",
   "description": "Security review, auth, crypto, secrets, injection.",
   "keywords": [
    "security",
    "vulnerab",
    "auth(entication|orization|n|z)?\\b",
    "oauth",
    "jwt",
    "crypt",
    "xss",
    "csrf",
    "sql injection",
    "secrets?",
    "sandbox escape",
    "cve"
   ]
  },
  "feature": {
   "tier": "standard",
   "pattern": "cascade",
   "description": "Implement a well-scoped feature or multi-file change.",
   "keywords": [
    "implement",
    "\\badd\\b",
    "build",
    "create (a|an) ",
    "feature",
    "endpoint",
    "integrate",
    "wire up",
    "support for"
   ]
  },
  "debugging": {
   "tier": "standard",
   "pattern": "single",
   "description": "Ordinary bugs with an error message or failing test.",
   "keywords": [
    "\\bfix\\b",
    "\\bbug\\b",
    "error",
    "exception",
    "stack ?trace",
    "traceback",
    "failing",
    "broken",
    "doesn'?t work",
    "crash"
   ]
  },
  "refactor": {
   "tier": "standard",
   "pattern": "single",
   "description": "Restructure code without changing behavior.",
   "keywords": [
    "refactor",
    "clean ?up",
    "extract (a )?(function|method|class)",
    "deduplicate",
    "simplify",
    "restructure",
    "modulari"
   ]
  },
  "tests": {
   "tier": "standard",
   "pattern": "single",
   "description": "Write or update tests, raise coverage.",
   "keywords": [
    {
     "re": "unit tests?",
     "w": 2
    },
    {
     "re": "(write|add) (\\w+ )?tests?",
     "w": 2
    },
    "test cases?",
    "coverage",
    "pytest",
    "jest",
    "vitest",
    "e2e",
    "integration tests?",
    "mock"
   ]
  },
  "review": {
   "tier": "standard",
   "pattern": "single",
   "description": "Code review of a diff or PR.",
   "keywords": [
    "review",
    "\\bpr\\b",
    "pull request",
    "diff",
    "code smell"
   ]
  },
  "routine_edit": {
   "tier": "fast",
   "pattern": "single",
   "description": "Mechanical/local edits — rename, typo, formatting, small config change.",
   "keywords": [
    {
     "re": "rename",
     "w": 3
    },
    {
     "re": "typo",
     "w": 3
    },
    "format",
    "lint",
    "bump (the )?version",
    "update (the )?(import|dependency|version)",
    "add (a )?(comment|docstring|log line)",
    "change .* to ",
    "one-?liner",
    "remove unused"
   ]
  },
  "docs": {
   "tier": "fast",
   "pattern": "single",
   "description": "READMEs, docstrings, changelogs, comments.",
   "keywords": [
    "readme",
    "docstring",
    "documentation",
    "\\bdocs?\\b",
    "changelog",
    "jsdoc",
    "comment"
   ]
  },
  "search": {
   "tier": "fast",
   "pattern": "single",
   "description": "Find/locate/explain where something is; read-only exploration.",
   "keywords": [
    "where is",
    "find (all|the|where)?",
    "locate",
    "search",
    "grep",
    "list (all|the)",
    "which files?",
    "what does .* do",
    "explain",
    "how does",
    "summari[sz]e",
    "overview"
   ]
  }
 },
 "fallback_category": "feature",
 "signals": {
  "bump_up": [
   "across (the )?(codebase|repo|services|modules|files)",
   "multiple (files|services|modules|repos)",
   "\\b(entire|whole) (codebase|repo|system)",
   "production|prod incident|outage|customer-facing",
   "ambiguous|unclear|not sure (why|how)",
   "carefully|thorough|deep(ly)? (dive|analysis)"
  ],
  "bump_down": [
   "quick(ly)?|simple|small|trivial|just|minor",
   "\\bone (line|file|function)\\b"
  ],
  "long_prompt_chars": 1500,
  "bump_threshold": 2
 },
 "delegation": {
  "main_tier": {
   "default": "deep"
  },
  "inline_max_steps": 4,
  "inline_max_files": 1,
  "inline_max_task_chars": 120,
  "bulk_re": "\\b(all|every|each|across|batch|bulk|whole|entire|many|codebase|repo-wide)\\b",
  "max_subagents": 3,
  "wait_timeout_minutes": 30
 },
 "classifier": {
  "enabled": false,
  "confidence_threshold": 0.45,
  "command": null,
  "timeout_seconds": 5
 },
 "patterns": {
  "single": {
   "description": "One tier completes the task."
  },
  "cascade": {
   "description": "Draft on the routed tier; a judge on the next tier up approves or escalates.",
   "judge_tier_offset": 1,
   "max_escalations": 1
  },
  "critique": {
   "description": "Draft on the routed tier; N critics review in parallel; drafter revises once.",
   "critics": 2,
   "critic_tier": "standard"
  }
 },
 "escalate_on": [
  "judge_verdict_revise",
  "tests_fail_after_attempt",
  "tool_loop",
  "self_reported_low_confidence",
  "context_overflow"
 ],
 "sticky_main_thread": true,
 "default_provider": "github-copilot"
}
