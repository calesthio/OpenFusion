{
 "version": 1,
 "tiers": {
  "fast": {
   "description": "Cheapest/lowest-latency. Lookups, search, summaries, mechanical edits.",
   "relative_cost": 1
  },
  "standard": {
   "description": "Everyday coding. Feature work, tests, refactors, reviews.",
   "relative_cost": 5
  },
  "deep": {
   "description": "Strongest reasoning. Architecture, hard debugging, security, ambiguous specs.",
   "relative_cost": 20
  }
 },
